#!/usr/bin/env bash

# Retain a fixed number of the newest full and incremental snapshot archives.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: purge-old-snapshots [--keep-last-incremental COUNT] [--keep-last-full COUNT] [--dry-run]

Retains the newest COUNT archive files for each selected snapshot type and
dataset. Omit a snapshot type to leave its archive files untouched.
Snapshot archive filenames must end in a timestamp produced by the replication
scripts, such as dataset@2026-08-11T040001-0400.
EOF
}

KEEP_LAST_INCREMENTAL=''
KEEP_LAST_FULL=''
DRY_RUN=false

while (( $# > 0 )); do
  case "$1" in
    --keep-last-incremental)
      if (( $# < 2 )); then
        >&2 printf '%s requires a count\n' "$1"
        usage >&2
        exit 1
      fi
      KEEP_LAST_INCREMENTAL="$2"
      shift 2
      ;;
    --keep-last-full)
      if (( $# < 2 )); then
        >&2 printf '%s requires a count\n' "$1"
        usage >&2
        exit 1
      fi
      KEEP_LAST_FULL="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      >&2 printf 'Unknown option: %s\n' "$1"
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -n ${KEEP_LAST_INCREMENTAL} && \
  ! ${KEEP_LAST_INCREMENTAL} =~ ^[0-9]+$ ]] || \
  [[ -n ${KEEP_LAST_FULL} && ! ${KEEP_LAST_FULL} =~ ^[0-9]+$ ]]; then
  >&2 printf '%s\n' \
    '--keep-last-incremental and --keep-last-full require non-negative integers'
  usage >&2
  exit 1
fi

# Change working directory to script directory.
cd "$(dirname "${BASH_SOURCE[0]}")"

# shellcheck disable=SC1091
. .env

purge_snapshot_archives() {
  local directory="$1"
  local snapshot_type="$2"
  local keep_count="$3"
  local file
  local dataset
  local filename
  local record
  local relative_path
  local timestamp
  local -A retained_counts=()

  if [[ ! -d ${directory} ]]; then
    printf 'Directory %s does not exist, skipping %s snapshots\n' \
      "${directory}" "${snapshot_type}"
    return
  fi

  printf 'Purging %s snapshots in %s, keeping %s per dataset\n' \
    "${snapshot_type}" "${directory}" "${keep_count}"

  # ISO-formatted timestamps sort chronologically, so process newest archives
  # first within each dataset while maintaining separate retention counters.
  while IFS= read -r -d '' record; do
    dataset="${record%%$'\t'*}"
    record="${record#*$'\t'}"
    timestamp="${record%%$'\t'*}"
    file="${record#*$'\t'}"

    if (( ${retained_counts["${dataset}"]:-0} < keep_count )); then
      retained_counts["${dataset}"]=$(( ${retained_counts["${dataset}"]:-0} + 1 ))
      printf 'Keeping %s snapshot archive: %s\n' "${snapshot_type}" "${file}"
      continue
    fi

    if [[ ${DRY_RUN} == true ]]; then
      printf '[DRY RUN] Would remove %s snapshot archive: %s\n' \
        "${snapshot_type}" "${file}"
    else
      printf 'Removing %s snapshot archive: %s\n' "${snapshot_type}" "${file}"
      rm -- "${file}"
    fi
  done < <(
    {
      while IFS= read -r -d '' file; do
        filename="${file##*/}"
        timestamp="${filename##*@}"
        relative_path="${file#"${directory}"/}"
        dataset="${relative_path%@*}"

        if [[ ${timestamp} =~ ^[0-9]{4}-([0-9]{2}[0-9]{2}|[0-9]{2}-[0-9]{2})T[0-9]{6}(Z|[-+][0-9]{4})$ ]]; then
          printf '%s\t%s\t%s\0' "${dataset}" "${timestamp}" "${file}"
        else
          >&2 printf 'Skipping %s snapshot archive with unrecognized timestamp: %s\n' \
            "${snapshot_type}" "${file}"
        fi
      done < <(find "${directory}" -type f -name '*@*' -print0)
    } | sort --field-separator=$'\t' --key=1,1 --key=2,2r --zero-terminated
  )
}

if [[ -n ${KEEP_LAST_FULL} ]]; then
  purge_snapshot_archives "${FULL_SNAPSHOTS_DIR}" full "${KEEP_LAST_FULL}"
fi

if [[ -n ${KEEP_LAST_INCREMENTAL} ]]; then
  purge_snapshot_archives "${INCREMENTAL_SNAPSHOTS_DIR}" incremental \
    "${KEEP_LAST_INCREMENTAL}"
fi
